# Скопируйте этот файл в .env (или экспортируйте переменные другим способом перед запуском)
# и заполните реальными значениями для прод/стейджинг-окружения.
# Локально без .env всё работает на значениях по умолчанию из application.yml.

# --- База данных (Postgres) ---
DB_URL=jdbc:postgresql://localhost:5433/messenger
DB_USERNAME=messenger
DB_PASSWORD=messenger

# --- JWT ---
# Сгенерируйте случайную строку минимум 32 символа, например: openssl rand -base64 48
JWT_SECRET=change-this-super-secret-key-before-production-use-1234567890
JWT_EXPIRATION_MS=86400000

# --- Загрузки ---
UPLOADS_DIR=./uploads

# --- Почта (восстановление пароля), см. Mailtrap/аналог ---
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@prism.local
MAIL_ENABLED=false

# --- Публичный адрес приложения (используется в ссылках сброса пароля) ---
APP_BASE_URL=http://localhost:8081

# --- Порт (на бесплатных хостингах обычно подставляется автоматически) ---
PORT=8081
